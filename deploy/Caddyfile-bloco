# Linu Farol (Seiabras/linu-farol), da família Linu
farol.linupedia.com.br {
	# a identidade mora na Família Linu
	redir /identidade https://familia.linupedia.com.br/identidade 301
	# os pedidos (linu-pedidos no linuarquivos/servidor)
	handle /api/pedido {
		request_body {
			max_size 8KB
		}
		reverse_proxy 127.0.0.1:8094
	}
	# o contador de visitas sem cookie (servidor/linu-visitas): o aviso do v.js e a leitura do painel
	handle /api/visita /api/visitas {
		request_body {
			max_size 2KB
		}
		reverse_proxy 127.0.0.1:8095
	}
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Content-Security-Policy "default-src 'self'; img-src 'self' data:; font-src 'self'; style-src 'self'; script-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		X-Frame-Options DENY
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Strict-Transport-Security "max-age=31536000"
	}
	@arquivos path /img/* /fontes/* /css/* /js/*
	header @arquivos Cache-Control "public, max-age=604800"
	# o v.js entra no site dos clientes: um dia de cache, para uma correção chegar logo
	header /v.js Cache-Control "public, max-age=86400"
	root * /opt/linu-farol/app
	try_files {path} {path}.html {path}/index.html
	file_server
	handle_errors {
		@nao_achei expression {err.status_code} == 404
		rewrite @nao_achei /404.html
		file_server
	}
}

